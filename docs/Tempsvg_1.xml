<root><svg viewBox="0 0 1260 360" role="img" aria-label="Accounts and Finance entity-relationship diagram: chart_of_accounts references itself for sub-accounts; journal_lines references both journal_entries and chart_of_accounts; invoice_line_items references invoices; transactions references bank_accounts; bank_reconciliations references bank_accounts; budgets has no relationships.">
      <defs>
        <marker id="ar2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="currentColor"/>
        </marker>
      </defs>
      <!-- Row A (y 30-92): parents + standalone, all in one row so the 30-280 gap band stays empty -->
      <g font-family="-apple-system,Segoe UI,sans-serif">
        <rect x="60" y="30" width="180" height="62" rx="7" fill="var(--box-hub)" stroke="var(--ink-soft)" stroke-width="1.4"/>
        <text x="78" y="56" font-family="Courier New, monospace" font-weight="bold" font-size="12.5" fill="var(--ink)">chart_of_accounts</text>
        <text x="78" y="76" font-size="10" fill="var(--ink-soft)">account tree, self-referencing</text>

        <rect x="330" y="30" width="180" height="62" rx="7" fill="var(--box-hub)" stroke="var(--ink-soft)" stroke-width="1.4"/>
        <text x="350" y="56" font-family="Courier New, monospace" font-weight="bold" font-size="12.5" fill="var(--ink)">journal_entries</text>
        <text x="350" y="76" font-size="10" fill="var(--ink-soft)">draft &rarr; posted</text>

        <rect x="600" y="30" width="180" height="62" rx="7" fill="var(--box-hub)" stroke="var(--ink-soft)" stroke-width="1.4"/>
        <text x="620" y="56" font-family="Courier New, monospace" font-weight="bold" font-size="13" fill="var(--ink)">bank_accounts</text>
        <text x="620" y="76" font-size="10" fill="var(--ink-soft)">Dashboard cash balance</text>

        <rect x="870" y="30" width="150" height="62" rx="7" fill="var(--box-hub)" stroke="var(--ink-soft)" stroke-width="1.4"/>
        <text x="888" y="56" font-family="Courier New, monospace" font-weight="bold" font-size="13" fill="var(--ink)">invoices</text>
        <text x="888" y="76" font-size="10" fill="var(--ink-soft)">sales invoices</text>

        <rect x="1040" y="30" width="180" height="62" rx="7" fill="var(--box)" stroke="var(--line)" stroke-width="1.2" stroke-dasharray="3 3"/>
        <text x="1058" y="56" font-family="Courier New, monospace" font-weight="bold" font-size="13" fill="var(--ink)">budgets</text>
        <text x="1058" y="76" font-size="10" fill="var(--ink-soft)">no relationships</text>
      </g>

      <!-- connectors: row A bottom (y=92) to row B top (y=280) — the 92-280 band has no boxes in it, so every straight line here is collision-free regardless of x -->
      <g stroke="var(--ink-soft)" stroke-width="1.2" fill="none" marker-end="url(#ar2)">
        <line x1="245" y1="280" x2="245" y2="92"/>
        <line x1="290" y1="280" x2="150" y2="92"/>
        <line x1="560" y1="280" x2="670" y2="92"/>
        <line x1="890" y1="280" x2="945" y2="92"/>
        <line x1="1130" y1="280" x2="690" y2="92"/>
        <path d="M 240 46 C 300 38, 300 82, 240 74" stroke="var(--ink-soft)" fill="none" marker-end="url(#ar2)"/>
      </g>
      <g font-family="Courier New, monospace" font-size="10.5" fill="var(--ink-soft)">
        <rect x="205" y="175" width="94" height="15" fill="var(--surface)"/>
        <text x="207" y="186">journal_entry_id</text>
        <rect x="100" y="175" width="94" height="15" fill="var(--surface)"/>
        <text x="102" y="186">account_id</text>
        <rect x="580" y="175" width="105" height="15" fill="var(--surface)"/>
        <text x="582" y="186">bank_account_id</text>
        <rect x="850" y="175" width="70" height="15" fill="var(--surface)"/>
        <text x="852" y="186">invoice_id</text>
        <rect x="825" y="175" width="115" height="15" fill="var(--surface)"/>
        <text x="827" y="186">account_id, null</text>
        <rect x="248" y="55" width="90" height="14" fill="var(--surface)"/>
        <text x="250" y="65">parent_account_id</text>
      </g>

      <!-- Row B (y 280-340): children -->
      <g font-family="-apple-system,Segoe UI,sans-serif">
        <rect x="150" y="280" width="190" height="60" rx="7" fill="var(--box)" stroke="var(--line)" stroke-width="1.2"/>
        <text x="168" y="304" font-family="Courier New, monospace" font-weight="bold" font-size="12" fill="var(--ink)">journal_lines</text>
        <text x="168" y="322" font-size="10" fill="var(--ink-soft)">debit / credit, must balance</text>

        <rect x="450" y="280" width="210" height="60" rx="7" fill="var(--box)" stroke="var(--line)" stroke-width="1.2"/>
        <text x="466" y="304" font-family="Courier New, monospace" font-weight="bold" font-size="11" fill="var(--ink)">bank_reconciliations</text>
        <text x="466" y="322" font-size="10" fill="var(--ink-soft)">statement vs. book balance</text>

        <rect x="800" y="280" width="190" height="60" rx="7" fill="var(--box)" stroke="var(--line)" stroke-width="1.2"/>
        <text x="816" y="304" font-family="Courier New, monospace" font-weight="bold" font-size="11.5" fill="var(--ink)">invoice_line_items</text>
        <text x="816" y="322" font-size="10" fill="var(--ink-soft)">what's on the invoice</text>

        <rect x="1040" y="280" width="180" height="60" rx="7" fill="var(--box)" stroke="var(--line)" stroke-width="1.2"/>
        <text x="1056" y="304" font-family="Courier New, monospace" font-weight="bold" font-size="12.5" fill="var(--ink)">transactions</text>
        <text x="1056" y="322" font-size="9.5" fill="var(--ink-soft)">Dashboard + Reports read here</text>
      </g>
    </svg></root>