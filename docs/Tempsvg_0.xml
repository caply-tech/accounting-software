          <text x="886" y="304" font-family="Courier New, monospace" font-weight="bold" font-size="12.5" fill="var(--ink)">notifications</text>
          <text x="886" y="322" font-size="10" fill="var(--ink-soft)">Dashboard alerts feed</text>
        </g>
