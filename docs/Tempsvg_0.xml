        <text x="567" y="151">role_id</text>
        <rect x="700" y="178" width="86" height="15" fill="var(--surface)"/>
        <text x="702" y="189">business_id</text>
        <rect x="870" y="150" width="86" height="15" fill="var(--surface)"/>
